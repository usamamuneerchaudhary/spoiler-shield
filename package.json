{
  "name": "spoiler-shield",
  "version": "0.2.0",
  "private": true,
  "description": "Browser extension that hides story spoilers for GTA 6 and other games and shows until you've caught up. Unofficial fan project.",
  "license": "MIT",
  "author": "Usama Muneer (https://usamamuneer.me)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usamamuneerchaudhary/spoiler-shield.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test packages/matcher/test/*.test.js scripts/*.test.mjs",
    "test:e2e": "playwright test",
    "package": "node scripts/package.mjs",
    "spoiler": "node scripts/spoiler.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
