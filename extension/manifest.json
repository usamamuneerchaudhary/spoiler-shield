{
  "manifest_version": 3,
  "name": "Spoiler Shield",
  "short_name": "Spoiler Shield",
  "version": "0.1.0",
  "description": "Hides GTA 6 story spoilers on YouTube, Reddit and X until you've played that far. Unofficial fan project.",
  "homepage_url": "https://github.com/usamamuneerchaudhary/spoiler-shield",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Spoiler Shield",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://*.reddit.com/*",
        "https://x.com/*",
        "https://mobile.x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "vendor/matcher.js",
        "data/bundle.js",
        "config.js",
        "shared/settings.js",
        "content/sites.js",
        "content/shield-core.js",
        "content/main.js"
      ],
      "css": ["content/shield.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "spoiler-shield@usamamuneer.me",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
